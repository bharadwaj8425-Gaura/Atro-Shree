# Shree AI chat + automatic payment-screenshot check (Google AI Studio → Get API key, free)
GEMINI_API_KEY=paste-your-gemini-key
# GEMINI_MODEL=gemini-3.5-flash-lite

# UPI payments
UPI_ID=8484013977@ybl
UPI_NAME=Astro Shree
# Name exactly as it appears on payment screenshots (helps the auto-check), e.g. MANASVI BHARADWAJ
UPI_PAYEE_NAME=
# Last 4 digits of the bank account (if the payment app shows a masked account)
UPI_ACCOUNT_LAST4=

# Prices in ₹ — change any without touching code
